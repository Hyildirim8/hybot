<?xml version="1.0"?>
<package format="3">
  <name>robot_benchmark</name>
  <version>0.1.0</version>
  <description>ecza-robotu gercek ortam performans testi ve akademik rapor uretimi.
  Salt gozlem: mevcut navigasyon/motor dosyalarina dokunmaz, robotu
  kendiliginden hareket ettirmez.</description>
  <maintainer email="dev@ecza.local">ecza</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <!-- rapor uretimi icin; yoksa grafikler atlanir, tablolar yine uretilir -->
  <exec_depend>python3-matplotlib</exec_depend>
  <!-- --record-bag icin -->
  <exec_depend>ros2bag</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
