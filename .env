# ecza-robotu Docker Compose environment defaults
# Override any value inline: ROS_DOMAIN_ID=0 docker compose up
# Or edit this file before launching.

# DDS domain — must be 0 to match micro-ROS firmware (rmw_microxrcedds hardcodes domain 0)
# Safe range: 0–101 and 215–232
ROS_DOMAIN_ID=0

# Recording flag — set to 'true' to activate the recorder service
# Use scripts/launch.sh RECORD=true instead of setting this directly;
# the launch script translates RECORD=true into COMPOSE_PROFILES=record.
RECORD=false

# micro-ROS agent UDP port (must match ESP32 firmware provisioning)
AGENT_PORT=8888

# TCP port the host-side CSI camera streamer (scripts/csi_cam_stream.sh,
# ecza-robotu-csi-cam.service) listens on. The csi_camera container's
# rpicam_node connects here via 127.0.0.1 (network_mode: host).
CSI_CAM_PORT=8090

# micro-ROS agent verbosity (0=silent … 6=debug)
# Was hardcoded to 6 in docker-compose.yaml's micro-ros-agent command (this
# var was unused/dead) — that printed a hex dump of every DDS/serial packet
# on the exact bridge carrying wheel commands + encoder feedback, ~900
# lines/sec measured live. Almost certainly added scheduling jitter to the
# wheel command path. Now wired via ${VERBOSE:-1}; keep this low in normal
# operation, bump temporarily only when debugging the ESP32 link itself.
VERBOSE=1

# ── Isaac Sim mode (use with docker-compose.sim.yaml overlay) ─────────────────
# Topic name that Isaac Sim's RTX Lidar publishes to.
# In Isaac Sim: OmniGraph → ROS2 Publish LaserScan → topicName = "scan_sim"
SIM_SCAN_TOPIC=/scan_sim
