<?xml version="1.0"?>
<package format="3">
  <name>ecza_navigation</name>
  <version>0.1.0</version>
  <description>
    Nav2-based autonomous navigation stack for the ecza-robotu mecanum rover.
    Uses SLAM Toolbox for mapping and Nav2 for path planning + obstacle avoidance.
  </description>

  <maintainer email="rover@ecza-robotu.local">ecza-robotu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
